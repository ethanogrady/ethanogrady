{
  "name": "ethanogrady",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x",
    "npm": "10.x"
  },
  "browserslist": [
    ">0.3%",
    "last 2 versions",
    "safari >= 15.6",
    "ios_saf >= 15.6",
    "not dead",
    "not op_mini all"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "preview": "next build && wrangler pages dev out",
    "deploy": "next build && wrangler pages deploy out",
    "verify": "npm ci --dry-run",
    "studio": "sanity dev",
    "studio:deploy": "sanity deploy",
    "migrate": "node --env-file=.env.local scripts/migrate-to-sanity.mjs",
    "brand": "node scripts/generate-brand-images.mjs"
  },
  "dependencies": {
    "@sanity/image-url": "^2.1.1",
    "@sanity/orderable-document-list": "^2.0.18",
    "@sanity/ui": "^3.5.2",
    "@sanity/vision": "^6.9.1",
    "lenis": "^1.3.26",
    "next": "16.3.0",
    "next-sanity": "^13.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanity": "^6.9.1",
    "sanity-plugin-media": "^6.1.1",
    "styled-components": "^6.5.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "typescript": "^5",
    "wrangler": "^4.119.0"
